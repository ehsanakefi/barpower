datasource db {
  provider = "postgresql" // اگر از SQLite استفاده می‌کنید به "sqlite" تغییر دهید
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ۱. اینام‌ها (Enums)
// ==========================================

enum Role {
  ADMIN
  USER
}

enum DatasetType {
  LOAD                  // داده‌های بار ساعتی
  TEMPORAL_CONSTRAINTS  // محدودیت‌های زمانی
  FEEDER_RELATIONS      // روابط بین فیدرها
}

enum RelationType {
  SIMULTANEOUS      // هم‌زمان
  NON_SIMULTANEOUS  // غیرهم‌زمان
}

enum RunStatus {
  READY
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  INFEASIBLE
}

// ==========================================
// ۲. کاربران و سطوح دسترسی (Users & Roles)
// ==========================================
model User {
  id           String        @id @default(cuid())
  email        String?       @unique
  username     String        @unique
  passwordHash String        // هش رمز عبور (bcrypt یا argon2)
  fullName     String?
  role         Role          @default(USER)
  isActive     Boolean       @default(true)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // سابقه عملیات کاربر (اختیاری جهت Audit Log)
  datasets     Dataset[]
  scheduleRuns ScheduleRun[]

  @@map("users")
}

// ==========================================
// ۳. فیدرها (Feeders)
// ==========================================
model Feeder {
  id             String   @id @default(cuid())
  code           String   @unique // مثلاً F-101
  name           String   // نام فیدر
  substationName String?  // نام پست بالادست

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // روابط با سایر جداول
  temporalConstraints TemporalConstraint[]
  baseRelations       FeederRelation[]     @relation("BaseFeederRelation")
  targetRelations     FeederRelation[]     @relation("TargetFeederRelation")
  outageEvents        OutageEvent[]

  @@map("feeders")
}

// ==========================================
// ۴. مجموعه‌داده‌ها و فایل‌های آپلود شده (Datasets)
// ==========================================
model Dataset {
  id          String      @id @default(cuid())
  name        String      // نام فایل یا نام دلخواه
  type        DatasetType // نوع مجموعه
  fileName    String?     // نام اصلی فایل اکسل
  recordCount Int         @default(0)
  version     Int         @default(1)

  // کاربری که فایل یا مجموعه را ثبت کرده
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // رکوردها و وابستگی‌ها
  loadRecords         LoadRecord[]
  temporalConstraints TemporalConstraint[]
  feederRelations     FeederRelation[]

  // سابقه استفاده در اجراهای الگوریتم
  loadRuns      ScheduleRun[] @relation("LoadDatasetRuns")
  temporalRuns  ScheduleRun[] @relation("TemporalDatasetRuns")
  relationRuns  ScheduleRun[] @relation("RelationDatasetRuns")

  @@map("datasets")
}

// ==========================================
// ۵. رکوردهای بار مصرفی ساعتی (Load Records)
// ==========================================
model LoadRecord {
  id                String   @id @default(cuid())
  datasetId         String
  dataset           Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  operatorName      String?  // نام اپراتور / شرکت توزیع
  stationType       String?  // نوع ایستگاه
  stationPgdsCode   String   // کد دیسپاچینگ ایستگاه
  equipmentType     String?  // نوع تجهیز
  equipment         String?  // نام تجهیز
  equipmentPgdsCode String?  // کد دیسپاچینگ تجهیز
  energyType        String?  // نوع انرژی

  date              String   // تاریخ (شمسی یا میلادی استاندارد)
  total             Float    @default(0) // جمع مصرف روز

  // بارهای مصرفی ۲۴ ساعت شبانه‌روز (مگاوات)
  h1  Float?
  h2  Float?
  h3  Float?
  h4  Float?
  h5  Float?
  h6  Float?
  h7  Float?
  h8  Float?
  h9  Float?
  h10 Float?
  h11 Float?
  h12 Float?
  h13 Float?
  h14 Float?
  h15 Float?
  h16 Float?
  h17 Float?
  h18 Float?
  h19 Float?
  h20 Float?
  h21 Float?
  h22 Float?
  h23 Float?
  h24 Float?

  createdAt DateTime @default(now())

  @@index([datasetId])
  @@index([date])
  @@index([stationPgdsCode])
  @@map("load_records")
}

// ==========================================
// ۶. محدودیت‌های زمانی فیدرها (Temporal Constraints)
// ==========================================
model TemporalConstraint {
  id             String   @id @default(cuid())
  datasetId      String?
  dataset        Dataset? @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  feederId       String
  feeder         Feeder   @relation(fields: [feederId], references: [id], onDelete: Cascade)

  date           String   // تاریخ مد نظر
  constraintCode Int      // کدهای محدودیت (۰ تا ۶)

  createdAt      DateTime @default(now())

  @@index([feederId, date])
  @@index([datasetId])
  @@map("temporal_constraints")
}

// ==========================================
// ۷. روابط بین فیدرها (Feeder Relations)
// ==========================================
model FeederRelation {
  id              String       @id @default(cuid())
  datasetId       String?
  dataset         Dataset?     @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  baseFeederId    String
  baseFeeder      Feeder       @relation("BaseFeederRelation", fields: [baseFeederId], references: [id], onDelete: Cascade)

  relatedFeederId String
  relatedFeeder   Feeder       @relation("TargetFeederRelation", fields: [relatedFeederId], references: [id], onDelete: Cascade)

  relationType    RelationType

  createdAt       DateTime     @default(now())

  @@unique([baseFeederId, relatedFeederId, datasetId])
  @@map("feeder_relations")
}

// ==========================================
// ۸. درخواست‌های اجرای محاسبه هفتگی (Schedule Runs)
// ==========================================
model ScheduleRun {
  id            String    @id @default(cuid())
  status        RunStatus @default(READY)
  weekStartDate String    // تاریخ شروع هفته (مثلاً ۱۴۰۳/۰۶/۱۰)
  errorMessage  String?

  // کاربری که دستور اجرا را صادر کرده
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // شناسه‌های مجموعه‌های ورودی که برای این محاسبه استفاده شده‌اند
  loadDatasetId     String?
  loadDataset       Dataset? @relation("LoadDatasetRuns", fields: [loadDatasetId], references: [id], onDelete: SetNull)

  temporalDatasetId String?
  temporalDataset   Dataset? @relation("TemporalDatasetRuns", fields: [temporalDatasetId], references: [id], onDelete: SetNull)

  relationsDatasetId String?
  relationsDataset   Dataset? @relation("RelationDatasetRuns", fields: [relationsDatasetId], references: [id], onDelete: SetNull)

  // رویدادهای خاموشی تولید شده حاصل از این اجرا
  outageEvents  OutageEvent[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("schedule_runs")
}

// ==========================================
// ۹. رویدادهای تقویم خاموشی نهایی (Outage Events)
// ==========================================
model OutageEvent {
  id        String      @id @default(cuid())
  runId     String
  run       ScheduleRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  feederId  String
  feeder    Feeder      @relation(fields: [feederId], references: [id], onDelete: Cascade)

  date      String      // تاریخ خاموشی (مثلاً ۱۴۰۳/۰۶/۱۰)
  weekday   String      // نام روز هفته (شنبه، یکشنبه، ...)
  startTime String      // ساعت شروع (مثلاً "12:00")
  endTime   String      // ساعت پایان (مثلاً "14:00")

  createdAt DateTime    @default(now())

  @@index([runId])
  @@index([feederId])
  @@map("outage_events")
}

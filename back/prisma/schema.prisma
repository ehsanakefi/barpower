datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ۱. اینام‌ها (Enums)
// ==========================================

enum Role {
  SUPER_ADMIN // ادمین کل سامانه (مدیریت شرکت‌ها)
  USER        // کاربر/اپراتور شرکت توزیع برق
}

enum DatasetType {
  LOAD                  // داده‌های بار ساعتی
  TEMPORAL_CONSTRAINTS  // محدودیت‌های زمانی
  FEEDER_RELATIONS      // روابط بین فیدرها
}

enum RelationType {
  SIMULTANEOUS      // هم‌زمان
  NON_SIMULTANEOUS  // غیرهم‌زمان
}

enum RunStatus {
  READY
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  INFEASIBLE
}

// ==========================================
// ۲. شرکت‌های توزیع برق (Companies)
// ==========================================
model Company {
  id          String   @id @default(cuid())
  code        String   @unique // مثلاً "EPDC_HAMEDAN"
  name        String   // شرکت توزیع نیروی برق استان همدان
  province    String?  // استان
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  feeders      Feeder[]
  datasets     Dataset[]
  scheduleRuns ScheduleRun[]

  @@map("companies")
}

// ==========================================
// ۳. کاربران (Users)
// ==========================================
model User {
  id           String        @id @default(cuid())
  companyId    String?       // برای SUPER_ADMIN می‌تواند null باشد، برای USER اجباری است
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email        String?
  username     String        @unique
  passwordHash String
  fullName     String?
  role         Role          @default(USER)
  isActive     Boolean       @default(true)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  datasets     Dataset[]
  scheduleRuns ScheduleRun[]

  @@index([companyId])
  @@map("users")
}

// ==========================================
// ۴. فیدرها (Feeders)
// ==========================================
model Feeder {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code           String   // مثلاً F-101
  name           String
  substationName String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  temporalConstraints TemporalConstraint[]
  baseRelations       FeederRelation[]     @relation("BaseFeederRelation")
  targetRelations     FeederRelation[]     @relation("TargetFeederRelation")
  outageEvents        OutageEvent[]

  // کد فیدر در هر شرکت توزیع یکتاست، نه در کل کشور
  @@unique([companyId, code])
  @@index([companyId])
  @@map("feeders")
}

// ==========================================
// ۵. مجموعه‌داده‌ها (Datasets)
// ==========================================
model Dataset {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  type        DatasetType
  fileName    String?
  recordCount Int         @default(0)
  version     Int         @default(1)

  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  loadRecords         LoadRecord[]
  temporalConstraints TemporalConstraint[]
  feederRelations     FeederRelation[]

  loadRuns      ScheduleRun[] @relation("LoadDatasetRuns")
  temporalRuns  ScheduleRun[] @relation("TemporalDatasetRuns")
  relationRuns  ScheduleRun[] @relation("RelationDatasetRuns")

  @@index([companyId])
  @@map("datasets")
}

// ==========================================
// ۶. رکوردهای بار ساعتی (Load Records)
// ==========================================
model LoadRecord {
  id                String   @id @default(cuid())
  datasetId         String
  dataset           Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  operatorName      String?
  stationType       String?
  stationPgdsCode   String
  equipmentType     String?
  equipment         String?
  equipmentPgdsCode String?
  energyType        String?

  date              String
  total             Float    @default(0)

  h1  Float?
  h2  Float?
  h3  Float?
  h4  Float?
  h5  Float?
  h6  Float?
  h7  Float?
  h8  Float?
  h9  Float?
  h10 Float?
  h11 Float?
  h12 Float?
  h13 Float?
  h14 Float?
  h15 Float?
  h16 Float?
  h17 Float?
  h18 Float?
  h19 Float?
  h20 Float?
  h21 Float?
  h22 Float?
  h23 Float?
  h24 Float?

  createdAt DateTime @default(now())

  @@index([datasetId])
  @@index([date])
  @@index([stationPgdsCode])
  @@map("load_records")
}

// ==========================================
// ۷. محدودیت‌های زمانی (Temporal Constraints)
// ==========================================
model TemporalConstraint {
  id             String   @id @default(cuid())
  datasetId      String?
  dataset        Dataset? @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  feederId       String
  feeder         Feeder   @relation(fields: [feederId], references: [id], onDelete: Cascade)

  date           String
  constraintCode Int

  createdAt      DateTime @default(now())

  @@index([feederId, date])
  @@index([datasetId])
  @@map("temporal_constraints")
}

// ==========================================
// ۸. روابط فیدرها (Feeder Relations)
// ==========================================
model FeederRelation {
  id              String       @id @default(cuid())
  datasetId       String?
  dataset         Dataset?     @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  baseFeederId    String
  baseFeeder      Feeder       @relation("BaseFeederRelation", fields: [baseFeederId], references: [id], onDelete: Cascade)

  relatedFeederId String
  relatedFeeder   Feeder       @relation("TargetFeederRelation", fields: [relatedFeederId], references: [id], onDelete: Cascade)

  relationType    RelationType

  createdAt       DateTime     @default(now())

  @@unique([baseFeederId, relatedFeederId, datasetId])
  @@map("feeder_relations")
}

// ==========================================
// ۹. زمان‌بندی‌ها (Schedule Runs)
// ==========================================
model ScheduleRun {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  status        RunStatus @default(READY)
  weekStartDate String
  errorMessage  String?

  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  loadDatasetId     String?
  loadDataset       Dataset? @relation("LoadDatasetRuns", fields: [loadDatasetId], references: [id], onDelete: SetNull)

  temporalDatasetId String?
  temporalDataset   Dataset? @relation("TemporalDatasetRuns", fields: [temporalDatasetId], references: [id], onDelete: SetNull)

  relationsDatasetId String?
  relationsDataset   Dataset? @relation("RelationDatasetRuns", fields: [relationsDatasetId], references: [id], onDelete: SetNull)

  outageEvents  OutageEvent[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@map("schedule_runs")
}

// ==========================================
// ۱۰. رویدادهای خاموشی (Outage Events)
// ==========================================
model OutageEvent {
  id        String      @id @default(cuid())
  runId     String
  run       ScheduleRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  feederId  String
  feeder    Feeder      @relation(fields: [feederId], references: [id], onDelete: Cascade)

  date      String
  weekday   String
  startTime String
  endTime   String

  createdAt DateTime    @default(now())

  @@index([runId])
  @@index([feederId])
  @@map("outage_events")
}

{
  "name": "docpower-backend",
  "version": "1.0.0",
  "description": "A technical document portal with title-based search functionality.",
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "ts-node -r tsconfig-paths/register server.ts",
    "build": "tsc",
    "migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "test": "jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test dotenv -e .env.test -- vitest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^2.2.2",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "jsonwebtoken": "^8.5.1",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/core": "^27.5.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^27.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^16.11.7",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.7",
    "jest": "^27.5.1",
    "jest-environment-node": "^27.5.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-node-dev": "^1.1.8",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "document",
    "portal",
    "search",
    "postgresql",
    "prisma"
  ],
  "author": "Your Name",
  "license": "MIT"
}

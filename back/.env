# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (when switching from mock to real DB)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/power_app_db?schema=public

# JWT Authentication
JWT_SECRET=secret-a1b2c3d4e5f67890
JWT_EXPIRES_IN=7d

# Python GPU Service Configuration
PYTHON_API_ENABLED=true
PYTHON_API_URL=http://localhost:8000
PYTHON_API_TIMEOUT=30000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS Configuration
CORS_ORIGIN=http://192.168.80.30:3000

